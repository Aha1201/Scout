# 复制成 .env 并填入真实值： cp .env.example .env

# GitHub Personal Access Token（免费）。无需任何 scope，classic token 即可，
# 仅用于把匿名 60 req/h 的限额提升到 5000 req/h。
# 生成： https://github.com/settings/tokens  ->  Generate new token (classic) -> 不勾任何权限
GITHUB_TOKEN=

# DeepSeek API key，用于需求结构化 + AI 精排（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 精排模型（核心质量）。deepseek-chat=V3(快/便宜)；deepseek-reasoner=R1(更会推理，稍贵)
RERANK_MODEL=deepseek-chat
# 需求结构化，便宜的就够
PROFILE_MODEL=deepseek-chat

# LinkedIn 召回源（可选，--source linkedin/both 时才需要）。
# 经 CoreSignal 合规 API：https://coresignal.com  注册拿 key（Starter ~$49/月）
CORESIGNAL_API_KEY=
# CORESIGNAL_BASE=https://api.coresignal.com/cdapi
